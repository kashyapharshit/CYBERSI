PORT=4000
HOST=0.0.0.0
MONGO_URI=mongodb://127.0.0.1:27017/CYBER_DB
API_KEY=replace-with-a-long-random-machine-key
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173
AI_ENGINE_URL=http://127.0.0.1:8000/run-analysis
FASTAPI_LLM_URL=http://127.0.0.1:8000/analyst-query
PYTHON_OPTIMIZER_URL=http://127.0.0.1:8000/optimize
PYTHON_OPTIMIZER_COMPARISON_URL=http://127.0.0.1:8000/optimizer-comparison
AI_REQUEST_TIMEOUT_MS=15000
CONTROL_OVERLAP_FACTOR=0.65
MAX_COMBINED_REDUCTION=0.85
DATASET_VERSION=synthetic-2026-09-10
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=replace-with-a-dedicated-demo-wallet-key

# Required only when running `npm run seed:users`.
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
BOOTSTRAP_ANALYST_EMAIL=analyst@example.local
BOOTSTRAP_ANALYST_PASSWORD=replace-with-a-strong-analyst-password
