{
  "info": {
    "name": "Cyber Backend Fixes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "email", "value": "admin@example.com" },
    { "key": "password", "value": "replace-me" },
    { "key": "apiKey", "value": "replace-me" },
    { "key": "jwt", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "AI Payload",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
        "url": "{{baseUrl}}/ai/payload"
      }
    },
    {
      "name": "AI Results With Fallback",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-api-key", "value": "{{apiKey}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"model_version\": \"postman-fallback-test\",\n  \"asset_risks\": []\n}" },
        "url": "{{baseUrl}}/ai/results"
      }
    },
    {
      "name": "Risks",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
        "url": "{{baseUrl}}/risks"
      }
    },
    {
      "name": "What If",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"simulated_control_ids\": [\"REM-MFA-01\", \"REM-EDR-02\"],\n  \"delay_days\": 0\n}" },
        "url": "{{baseUrl}}/analytics/what-if"
      }
    },
    {
      "name": "Python Optimizer Adapter",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"objective\": \"maximize_risk_reduction\",\n  \"budget_inr\": 2000000\n}" },
        "url": "{{baseUrl}}/analytics/optimize"
      }
    },
    {
      "name": "Blockchain Status",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
        "url": "{{baseUrl}}/ai/blockchain-status"
      }
    },
    {
      "name": "Verify Data",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/ai/verify-data" }
    },
    {
      "name": "Tamper Test",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
        "url": "{{baseUrl}}/ai/verify-data/tamper-test"
      }
    }
  ]
}
