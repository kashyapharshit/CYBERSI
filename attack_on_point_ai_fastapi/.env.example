HOST=0.0.0.0
PORT=8000

# Must match the Node backend API_KEY.
AI_API_KEY=replace-with-the-same-value-as-backend-API_KEY
REQUIRE_API_KEY=true

BACKEND_AI_PAYLOAD_URL=http://127.0.0.1:4000/ai/payload
BACKEND_AI_RESULTS_URL=http://127.0.0.1:4000/ai/results
BACKEND_TIMEOUT_SECONDS=30

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=90

MONTE_CARLO_TRIALS=4000
MONTE_CARLO_SEED=20260925
CONTROL_OVERLAP_FACTOR=0.65
MAX_COMBINED_REDUCTION=0.85
OPTIMIZER_BUDGET_UNIT_INR=1000
